# Copy to .env and fill in the credentials below. .env is gitignored.

# ── Required ────────────────────────────────────────────────────────────────
# Register an app at https://developer.unimicro.no/portal/applications, add a
# client to it, and set the client's callback URL to <PUBLIC_URL>/oauth/callback
# — for local development that is exactly:
#     http://localhost:3000/oauth/callback
#
# Either client type works:
#   "Mobile/native app"  public client, no secret. Leave the secret blank.
#   "Regular web app"    confidential client. Set the secret too.
UNIMICRO_CLIENT_ID=
UNIMICRO_CLIENT_SECRET=

# ── Optional: the defaults below target Unimicro's test environment ─────────
# PORT=3000
# PUBLIC_URL=http://localhost:3000
# UNIMICRO_ISSUER=https://test-login.unimicro.no
# UNIMICRO_API_BASE_URL=https://test.unimicro.no
# UNIMICRO_SCOPES=openid profile offline_access AppFramework

# Extra browser origins allowed to call /mcp, comma-separated.
# localhost is always allowed; native MCP clients send no Origin and need nothing here.
# ALLOWED_ORIGINS=

# LOG_LEVEL=info
