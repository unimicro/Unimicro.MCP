# Copy to .env and fill in the credentials from your client in the developer
# portal. See the README for where these come from. .env is gitignored.

UNIMICRO_CLIENT_ID=
# Only for a "Regular web app" client. Leave blank for a "Mobile/native app".
UNIMICRO_CLIENT_SECRET=

# Which Unimicro environment to talk to: dev or test. This one switch sets both
# the identity provider and the API, so they cannot drift apart. Register your
# application in the portal for the same environment:
#
#   dev    dev-developer.unimicro.no   dev-login.unimicro.no    dev.unimicro.no
#   test   developer.unimicro.no       test-login.unimicro.no   test.unimicro.no
#
# Credentials are per-environment: a client from one will not work against the
# other, and the failure does not mention environments.
# UNIMICRO_ENV=dev

# ── Optional ────────────────────────────────────────────────────────────────
# The port to listen on. PUBLIC_URL follows it automatically, so this is the
# only thing you change to move ports — but the callback URL registered on your
# client in the portal must match, so register localhost:<PORT>/oauth/callback.
# PORT=3000
#
# Set only when the public address differs from the bind address (a proxy, or a
# container). Otherwise leave it alone and let PORT drive it.
# PUBLIC_URL=http://localhost:3000
#
# Override UNIMICRO_ENV's URLs individually. Rarely needed, and overriding just
# one gives you a mixed set — the startup banner will say "custom" if you do.
# UNIMICRO_ISSUER=
# UNIMICRO_API_BASE_URL=
#
# Every scope here must also be listed on your client in the portal — asking for
# one it does not have fails sign-in with `invalid_scope`. `AppFramework` is what
# grants API access. Tokens last one hour; add `offline_access` to get a refresh
# token, but only if your client carries that scope too.
# UNIMICRO_SCOPES=openid profile AppFramework
#
# Extra browser origins allowed to call /mcp, comma-separated. localhost is
# always allowed; native MCP clients send no Origin and need nothing here.
# ALLOWED_ORIGINS=
#
# LOG_LEVEL=info
