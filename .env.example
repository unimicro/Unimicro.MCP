# Copy to .env and fill in the credentials from your client in the developer
# portal. See the README for where these come from. .env is gitignored.

UNIMICRO_CLIENT_ID=
# Only for a "Regular web app" client. Leave blank for a "Mobile/native app".
UNIMICRO_CLIENT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# PORT=3000
# PUBLIC_URL=http://localhost:3000
#
# Defaults match the environment you get from the sign-up in the README.
# UNIMICRO_ISSUER=https://dev-login.unimicro.no
# UNIMICRO_API_BASE_URL=https://dev.unimicro.no
#
# Every scope here must also be listed on your client in the portal.
# UNIMICRO_SCOPES=openid profile AppFramework
#
# Extra browser origins allowed to call /mcp, comma-separated. localhost is
# always allowed; native MCP clients send no Origin and need nothing here.
# ALLOWED_ORIGINS=
#
# LOG_LEVEL=info
